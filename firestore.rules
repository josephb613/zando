rules_version = '2';

// Règles Firestore de Sokoni.
// Déployer avec : npx firebase-tools deploy --only firestore:rules,storage
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    // Catalogue : lisible par tous (visiteurs compris), modifiable seulement par un admin.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Profil : chacun ne lit et n'écrit que le sien ; le numéro vient du jeton, pas du client.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.phone == request.auth.token.phone_number;
      allow delete: if false;

      // Panier (un seul document « current ») et carnet d'adresses : privés à leur propriétaire.
      match /cart/{doc} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn() && request.auth.uid == uid
          && request.resource.data.lines is list && request.resource.data.lines.size() <= 100;
      }
      match /addresses/{id} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.line is string
          && request.resource.data.name is string
          && request.resource.data.phone is string;
      }
    }

    // Commandes : créées uniquement par le module de commandes (server/, Admin SDK),
    // qui relit les prix produits et recalcule les totaux. Le client ne peut pas écrire
    // directement une commande, même avec un total falsifié.
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if false;
      allow update, delete: if isAdmin();
    }
  }
}
